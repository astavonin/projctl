#!/usr/bin/env bash
# Block commits that would publish proprietary identifiers to this public repository.
#
# projctl publishes to github.com/astavonin/projctl, so every tracked file is world
# readable the moment it is pushed — and git history keeps it readable even after a
# later commit removes the string.
#
# Two classes of identifier are checked, and they cannot be stored the same way:
#
#   1. STRUCTURAL patterns, hardcoded below. A work-context absolute path has a shape
#      that names no employer, so the pattern itself is safe to publish.
#   2. LITERAL terms — an internal hostname, a group or project name, a colleague's
#      name. These have no shape to match; only the term itself identifies them, and
#      the term is exactly what must not be published. So they live in a denylist at
#      <git-common-dir>/proprietary-terms, which git never commits, pushes, or clones.
#      Committing the denylist would leak precisely what it exists to protect.
#
# WHICH BYTES ARE SCANNED. At commit time the index is scanned, not the working tree —
# `git grep --cached`. These differ routinely (`git add` then edit, `git add -p`,
# `git commit --only`, any IDE staging flow), and it is the index that becomes history.
# A manual sweep has no index to speak of and scans the working tree instead.
#
# FAILING TO LOOK IS NEVER "CLEAN". Every path that cannot be read, every command that
# errors, and every file git refuses to scan is reported and blocks. `git grep` signals
# an unreadable file on stderr while still exiting 1, so stderr — not just the exit
# status — decides whether the scan actually happened.
#
# KNOWN LIMITS, stated rather than implied. This is a backstop for manual review, not
# a replacement for it:
#   - `git commit --no-verify` bypasses this entirely, by design of git.
#   - `git merge` runs `pre-merge-commit`, not this hook; `git cherry-pick`, `git rebase`
#     and `git revert` run no pre-commit hook at all. Sweep by hand after any of them.
#   - `.git/hooks` is per-clone: a clone that never ran `make install-hooks` has no guard.
#   - A term broken across a line break is not matched; matching is line-oriented.
#   - Content only reachable through a submodule is not scanned.
#
# Install with `make install-hooks`. Sweep the whole working tree by hand at any time:
#     bash scripts/pre-commit

set -uo pipefail

fail() { printf 'pre-commit: %s\n' "$*" >&2; exit 1; }
warn() { printf 'pre-commit: %s\n' "$*" >&2; }

# `set -u` with `"${array[@]:offset:len}"` on an empty array needs bash 4.4+; macOS
# ships bash 3.2 as /bin/bash and the shebang is `env bash`, so this can genuinely be
# an old shell. Fail loudly: a guard that dies quietly is worse than one that is absent.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ] ||
   { [ "${BASH_VERSINFO[0]:-0}" -eq 4 ] && [ "${BASH_VERSINFO[1]:-0}" -lt 4 ]; }; then
    fail "needs bash 4.4+, found ${BASH_VERSION:-unknown}"
fi

REPO_ROOT=$(git rev-parse --show-toplevel) || fail "not inside a git working tree"
# Every git call and every reported path is root-relative from here on. `git grep`
# pathspecs and `--git-common-dir` both resolve against the cwd, so every git call must
# run from the root or a sweep launched from a subdirectory sees only that subdirectory.
cd "$REPO_ROOT" || fail "cannot enter repository root: $REPO_ROOT"

# --git-common-dir, not --git-dir: in a linked worktree the latter is
# .git/worktrees/<name>/, so each worktree would look for its own denylist and find
# none. The common dir is shared, so one list covers them all.
GIT_COMMON_DIR=$(git rev-parse --git-common-dir) || fail "cannot resolve the git common directory"
case "$GIT_COMMON_DIR" in /*) ;; *) GIT_COMMON_DIR="${REPO_ROOT}/${GIT_COMMON_DIR}" ;; esac
DENYLIST="${GIT_COMMON_DIR}/proprietary-terms"

# A work-context absolute path, as a POSIX ERE naming no employer. The username class
# admits dots and a leading digit: `first.last` is a standard corporate account name.
#
# TWO CONSUMERS, TWO ENGINES: `git grep -E` below, and `/usr/bin/grep -E` in the symlink
# pass (git grep will not read non-regular blobs). Keep this expressible in plain POSIX
# ERE so both agree; anything relying on one engine's extensions will silently diverge.
STRUCTURAL_PATTERN='home/[a-zA-Z0-9][a-zA-Z0-9._-]*/work/'

# Exactly one file is exempt, and only from the STRUCTURAL pass: its fixtures must
# contain sample work-paths to prove the pattern fires, or the hook flags itself and
# blocks every commit forever. It is NOT exempt from the denylist pass — nothing needs
# a real proprietary term in it. Anchored literal path, never a directory or glob.
EXCL_PATHSPEC=':(exclude,literal)tests/test_pre_commit_hook.py'

# Git sets GIT_INDEX_FILE for every hook and never for an interactive shell, so it tells
# us who invoked us. An empty staged list does not: a deletion-only commit and a
# message-only `git commit --amend` both produce one.
if [ -n "${GIT_INDEX_FILE:-}" ]; then MODE=index; else MODE=worktree; fi

TMPDIR_BASE="${TMPDIR:-/tmp}"
WORKDIR=$(mktemp -d "${TMPDIR_BASE%/}/projctl-precommit.XXXXXX") ||
    fail "cannot create a temporary directory under ${TMPDIR_BASE} — refusing to commit unchecked"
# INT/TERM/HUP as well as EXIT: bash does not run an EXIT trap for an untrapped SIGINT,
# so Ctrl-C would leave the decommented denylist — the proprietary terms — in /tmp.
trap 'rm -rf "$WORKDIR"' EXIT INT TERM HUP

HITS_FILE="${WORKDIR}/hits"
ERR_FILE="${WORKDIR}/err"
PATTERN_FILE="${WORKDIR}/terms"
SYMLINK_HITS_FILE="${WORKDIR}/symlink-hits"
PATHS_RAW="${WORKDIR}/paths"

# Collected paths are handed to git as PATHSPECS, so a filename beginning with ':' would
# be reinterpreted as pathspec magic — `:^handler.py` is git's exclude short-magic, and a
# file with that name silently removes handler.py from the scan. :(literal) disables all
# magic for the path it prefixes, while leaving $EXCL_PATHSPEC's own magic intact.
# (`--literal-pathspecs` would disarm that too, so it is not an option.)
declare -a PATHS=()
if [ "$MODE" = index ]; then
    # ACMRT: T is a typechange, whose content changes wholesale. D is correctly absent
    # (nothing to scan); U cannot reach a commit unresolved.
    git diff --cached --name-only -z --diff-filter=ACMRT > "$PATHS_RAW" ||
        fail "cannot list staged paths"
    while IFS= read -r -d '' p; do PATHS+=(":(literal)${p}"); done < "$PATHS_RAW"
fi

# `git grep -I` treats a path as binary when its `diff` attribute is unset, so one
# `*.md -diff` line in .gitattributes would make a whole glob unscannable — silently.
# Unscannable is not clean: report it and block.
check_unscannable() {
    local -a probe=()
    if [ "$MODE" = index ]; then
        [ "${#PATHS[@]}" -eq 0 ] && return 0
        probe=("${PATHS[@]}")
    else
        while IFS= read -r -d '' p; do probe+=(":(literal)${p}"); done \
            < <(git ls-files -z 2>/dev/null; git ls-files -z -o --exclude-standard 2>/dev/null)
        [ "${#probe[@]}" -eq 0 ] && return 0
    fi

    local i path _attr value unscannable=""
    for ((i = 0; i < ${#probe[@]}; i += 400)); do
        # Process substitution, not $(...): command substitution strips NUL bytes, so a
        # -z stream read through it yields nothing and every path reads as scannable.
        while IFS= read -r -d '' path && IFS= read -r -d '' _attr && IFS= read -r -d '' value; do
            # check-attr echoes the pathspec back verbatim, magic prefix included.
            path=${path#:(literal)}
            [ "$value" = "unset" ] && unscannable+="    ${path}"$'\n'
        done < <(git check-attr -z diff -- "${probe[@]:i:400}" 2>/dev/null)
    done
    if [ -n "$unscannable" ]; then
        printf 'pre-commit: these paths are marked binary by .gitattributes and cannot be scanned:\n%s' \
            "$unscannable"
        printf '  Clear their diff attribute, or review them by hand and use --no-verify.\n'
        exit 1
    fi
    return 0
}

# git grep exits 0 on a match, 1 on none, >1 on error — but it reports an unreadable
# file on stderr while STILL exiting 1. So the exit status alone cannot distinguish
# "found nothing" from "could not look"; stderr is the second half of that signal.
search() {
    local kind="$1" rc=1 chunk_rc i
    local -a args
    if [ "$kind" = structural ]; then
        args=(-I -n -E -e "$STRUCTURAL_PATTERN")
    else
        args=(-I -n -i -F -f "$PATTERN_FILE")
    fi

    : > "$HITS_FILE"; : > "$ERR_FILE"

    if [ "$MODE" = worktree ]; then
        if [ "$kind" = structural ]; then
            git grep --untracked "${args[@]}" -- . "$EXCL_PATHSPEC" \
                >> "$HITS_FILE" 2>> "$ERR_FILE"
        else
            git grep --untracked "${args[@]}" >> "$HITS_FILE" 2>> "$ERR_FILE"
        fi
        return $?
    fi

    [ "${#PATHS[@]}" -eq 0 ] && return 1
    # Chunked: git grep has no --pathspec-from-file, so paths go on the command line
    # and a large staged set would otherwise hit ARG_MAX.
    for ((i = 0; i < ${#PATHS[@]}; i += 400)); do
        if [ "$kind" = structural ]; then
            git grep --cached "${args[@]}" -- "${PATHS[@]:i:400}" "$EXCL_PATHSPEC" \
                >> "$HITS_FILE" 2>> "$ERR_FILE"
        else
            git grep --cached "${args[@]}" -- "${PATHS[@]:i:400}" \
                >> "$HITS_FILE" 2>> "$ERR_FILE"
        fi
        chunk_rc=$?
        [ "$chunk_rc" -gt 1 ] && return "$chunk_rc"
        [ "$chunk_rc" -eq 0 ] && rc=0
    done
    return "$rc"
}

# Runs `search` in the CURRENT shell so a scan error can terminate the hook — `fail`
# inside a command substitution would exit only the subshell.
scan_or_die() {
    local kind="$1" rc
    search "$kind"; rc=$?
    [ "$rc" -gt 1 ] && fail "scan failed (${kind}): $(cat "$ERR_FILE")"
    # rc==1 with output on stderr means git could not read something. Treating that as
    # "no match" is the fail-open this guard exists to prevent.
    [ -s "$ERR_FILE" ] && fail "scan could not read every file (${kind}): $(cat "$ERR_FILE")"
    return 0
}

# `git grep` skips non-regular blobs, so a symlink's own bytes are never scanned — and
# for a symlink those bytes ARE the committed content: the target path. Checked against
# the blob rather than the link's destination, so nothing outside the repo is read.
# Runs in both modes: a link committed under --no-verify, or before the hook existed, is
# exactly what a manual sweep is for.
scan_symlinks() {
    : > "$SYMLINK_HITS_FILE"
    local -a entries=()
    local rec mode sha path target i

    if [ "$MODE" = index ]; then
        [ "${#PATHS[@]}" -eq 0 ] && return 0
        for ((i = 0; i < ${#PATHS[@]}; i += 400)); do
            while IFS= read -r -d '' rec; do entries+=("$rec"); done \
                < <(git ls-files -s -z -- "${PATHS[@]:i:400}" 2>/dev/null)
        done
    else
        while IFS= read -r -d '' rec; do entries+=("$rec"); done \
            < <(git ls-files -s -z 2>/dev/null)
    fi

    for rec in "${entries[@]}"; do
        mode=${rec%% *}
        [ "$mode" = 120000 ] || continue
        rec=${rec#* }
        sha=${rec%% *}
        path=${rec#*$'\t'}
        target=$(git cat-file blob "$sha" 2>/dev/null) ||
            fail "cannot read the blob for symlink ${path}"
        if printf '%s' "$target" | grep -qE "$STRUCTURAL_PATTERN"; then
            printf '%s: symlink -> %s\n' "$path" "$target" >> "$SYMLINK_HITS_FILE"
        elif [ "$TERM_COUNT" -gt 0 ] &&
             printf '%s' "$target" | grep -qiFf "$PATTERN_FILE"; then
            printf '%s: symlink -> %s\n' "$path" "$target" >> "$SYMLINK_HITS_FILE"
        fi
    done
    return 0
}

FOUND=0
report() {
    if [ "$FOUND" -eq 0 ]; then
        printf 'pre-commit: proprietary identifiers found in the %s:\n' \
            "$([ "$MODE" = index ] && echo "staged content" || echo "working tree")"
        FOUND=1
    fi
    printf '\n  %s\n' "$1"
    printf '%s\n' "$2" | sed 's/^/    /'
}

check_unscannable

# --- 1. Denylist terms are parsed first, so the symlink pass can use them ---------
TERM_COUNT=0
if [ -f "$DENYLIST" ]; then
    # An existing-but-unreadable denylist is a failure to look, not "no terms": without
    # this it degrades into the same OFF warning a deliberately empty list produces, and
    # the commit proceeds unchecked.
    [ -r "$DENYLIST" ] || fail "denylist ${DENYLIST} exists but cannot be read"
    : > "$PATTERN_FILE" || fail "cannot write the denylist pattern file"
    while IFS= read -r line || [ -n "$line" ]; do
        # A '#' opens a comment only when followed by whitespace or end-of-line, so
        # `#acme-tag` and `acme#42` stay terms while `# note` and `acme  # note` do not.
        # Stripping from the first '#' anywhere silently discarded the first two.
        if [[ "$line" =~ ^[[:space:]]*#([[:space:]]|$) ]]; then
            continue
        fi
        if [[ "$line" =~ ^(.*[^[:space:]])[[:space:]]*#([[:space:]]|$) ]]; then
            line="${BASH_REMATCH[1]}"
        fi
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        # A UTF-8 BOM on the first line would otherwise become part of the term.
        line="${line#$'\xef\xbb\xbf'}"
        [ -z "$line" ] && continue
        printf '%s\n' "$line" >> "$PATTERN_FILE"
        TERM_COUNT=$((TERM_COUNT + 1))
    done < "$DENYLIST"
fi

# Emitted here, before any pass can report a hit: appended after the findings it would
# land between them and the remediation block, at the moment the developer is reading
# fastest. Loud but not blocking — a freshly seeded denylist is comment-only, so this is
# the state right after `make install-hooks`, and the literal-term half is the only half
# that can catch an internal hostname. Shipping inert while looking installed is the
# failure this line exists to prevent.
[ "$TERM_COUNT" -eq 0 ] &&
    warn "no denylist terms at ${DENYLIST} — literal-term checking is OFF"

# --- 2. Structural pattern -------------------------------------------------------
scan_or_die structural
if [ -s "$HITS_FILE" ]; then
    report "work-path pattern (hardcoded in scripts/pre-commit):" "$(cat "$HITS_FILE")"
fi

# --- 3. Denylisted literal terms -------------------------------------------------
if [ "$TERM_COUNT" -gt 0 ]; then
    scan_or_die terms
    if [ -s "$HITS_FILE" ]; then
        report "denylisted term (${DENYLIST}):" "$(cat "$HITS_FILE")"
    fi
fi

# --- 4. Symlinks, whose blobs git grep will not read -----------------------------
scan_symlinks
if [ -s "$SYMLINK_HITS_FILE" ]; then
    report "symlink target path (the link text is what gets committed):" \
        "$(cat "$SYMLINK_HITS_FILE")"
fi

if [ "$FOUND" -eq 1 ]; then
    cat <<EOF

This repository is public. Replace the above with generic equivalents
(gitlab.example.com, mygroup/myproject, /home/alice/projects/...) before
committing — a push makes the disclosure permanent in git history.

  Add a denylist term:  echo 'the-term' >> ${DENYLIST}
  The work-path pattern is hardcoded; edit scripts/pre-commit to change it.
  To commit anyway, disabling EVERY pre-commit check for that commit:
      git commit --no-verify
EOF
    exit 1
fi

# A manual sweep that finds nothing must say so: silence is also what a sweep that
# scanned zero files looks like, which is how the subdirectory bug stayed invisible.
[ "$MODE" = worktree ] &&
    printf 'pre-commit: working tree clean (%d denylist term(s) active)\n' "$TERM_COUNT"
exit 0
